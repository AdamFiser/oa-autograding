    {
      "id": "kosik",
      "name": "Košík",
      "prefix": "D",
      "file": "kosik.py",
      "checks": [
        {
          "id": "vychozi",
          "description": "`pridejDoKosiku(zbozi, kosik)` bez předaného košíku pokaždé začne prázdným košíkem",
          "type": "py.function",
          "name": "pridejDoKosiku",
          "cases": [
            {
              "args": [
                "tričko"
              ],
              "expected": [
                "tričko"
              ]
            },
            {
              "args": [
                "mikina"
              ],
              "expected": [
                "mikina"
              ]
            },
            {
              "args": [
                "čepice",
                [
                  "tričko"
                ]
              ],
              "expected": [
                "tričko",
                "čepice"
              ]
            }
          ],
          "hint": "Seznam jako výchozí hodnota se vytvoří jen jednou; použijte `kosik: list[str] | None = None` a prázdný seznam vytvořte uvnitř funkce (kapitola Past - seznam jako výchozí hodnota)."
        },
        {
          "id": "odeber",
          "description": "`odeberZKosiku(kosik, zbozi)` odebere první výskyt zboží z předaného košíku a vrátí, zda něco odebrala",
          "type": "py.function",
          "name": "odeberZKosiku",
          "cases": [
            {
              "args": [
                [
                  "tričko",
                  "mikina",
                  "tričko"
                ],
                "tričko"
              ],
              "expected": true,
              "args_after": [
                [
                  "mikina",
                  "tričko"
                ],
                "tričko"
              ]
            },
            {
              "args": [
                [
                  "tričko"
                ],
                "čepice"
              ],
              "expected": false,
              "args_after": [
                [
                  "tričko"
                ],
                "čepice"
              ]
            }
          ],
          "hint": "Funkce mění předaný seznam metodou `remove()`, která odebere první výskyt; předtím ověřte `in`, jinak `remove()` skončí chybou (kapitola Seznam jako argument)."
        },
        {
          "id": "souhrn",
          "description": "`souhrnKosiku(kosik)` vrátí slovník s počtem kusů každého zboží",
          "type": "py.function",
          "name": "souhrnKosiku",
          "cases": [
            {
              "args": [
                [
                  "tričko",
                  "mikina",
                  "tričko"
                ]
              ],
              "expected": {
                "tričko": 2,
                "mikina": 1
              }
            },
            {
              "args": [
                []
              ],
              "expected": {}
            }
          ],
          "hint": "Založte prázdný slovník `{}` a v cyklu zvyšujte počet u klíče, pro nový klíč začněte jedničkou nebo použijte `slovnik.get(klic, 0)`."
        },
        {
          "id": "cena-kosiku",
          "description": "`cenaKosiku(kosik, cenik)` vrátí součet cen zboží v košíku, zboží mimo ceník se nezapočítá",
          "type": "py.function",
          "name": "cenaKosiku",
          "cases": [
            {
              "args": [
                [
                  "tričko",
                  "mikina",
                  "tričko"
                ],
                {
                  "tričko": 250,
                  "mikina": 690
                }
              ],
              "expected": 1190
            },
            {
              "args": [
                [
                  "tričko",
                  "mikina",
                  "tričko",
                  "ponožky"
                ],
                {
                  "tričko": 250,
                  "mikina": 690
                }
              ],
              "expected": 1190
            },
            {
              "args": [
                [],
                {
                  "tričko": 250,
                  "mikina": 690
                }
              ],
              "expected": 0
            }
          ],
          "hint": "Cenu zboží najdete v ceníku `cenik[zbozi]`; zda zboží v ceníku je, ověřte předem operátorem `in`."
        },
        {
          "id": "cena-objednavky",
          "description": "`cenaObjednavky(cenaZbozi, slevaProcent, doprava)` započte slevu v % a dopravu, od 1500 Kč po slevě je doprava zdarma",
          "type": "py.function",
          "name": "cenaObjednavky",
          "cases": [
            {
              "args": [
                1000
              ],
              "expected": 1099
            },
            {
              "args": [
                1000,
                10
              ],
              "expected": 999
            },
            {
              "args": [
                2000
              ],
              "expected": 2000
            },
            {
              "args": [
                1600,
                10
              ],
              "expected": 1539
            },
            {
              "args": [
                1000,
                0,
                0
              ],
              "expected": 1000
            },
            {
              "args": [
                1999.99,
                25
              ],
              "expected": 1598.99
            }
          ],
          "hint": "Nejdřív odečtěte slevu `cenaZbozi * slevaProcent / 100`, pak rozhodněte o dopravě a výsledek zaokrouhlete `round(cena, 2)` (kapitola Výchozí hodnota parametru)."
        },
        {
          "id": "anotace",
          "description": "Všechny funkce v `kosik.py` mají typové anotace",
          "type": "py.signature",
          "hint": "Parametr se zapisuje `nazev: typ` a za závorku patří návratový typ `-> typ` (kapitola Typové anotace)."
        }
      ]
    },
