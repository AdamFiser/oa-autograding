{
  "schema": "oa-autograding/checks/v1",
  "title": "Cvičení 08: PHP - Formuláře",
  "tasks": [
    {
      "id": "priprava",
      "name": "Příprava a knihovna (Než začnete, úkol 1)",
      "prefix": "A",
      "file": "index.php",
      "checks": [
        {
          "id": "meta-author",
          "description": "Meta author vypisuje vaše jméno z konfigurace",
          "type": "php.page",
          "expected": "<meta name=\"author\" content=\"(?!yourName\")[^\"<]*\\S[^\"<]*\">",
          "comparison": "regex",
          "hint": "V `includes/config.php` přepište `yourName` na své jméno (Než začnete)."
        },
        {
          "id": "version",
          "description": "Patička ukazuje verzi `1.5`",
          "type": "php.page",
          "expected": "Maturita v1.5",
          "hint": "V `includes/config.php` nastavte `'version' => '1.5'` (Než začnete)."
        },
        {
          "id": "nacti-text",
          "description": "`nactiText(array $data, string $klic): string` vrací text bez okrajových mezer, jinak `''`",
          "type": "php.function",
          "file": "includes/formular.php",
          "name": "nactiText",
          "typed": true,
          "cases": [
            {
              "args": [
                {
                  "jmeno": "  Jan "
                },
                "jmeno"
              ],
              "expected": "Jan"
            },
            {
              "args": [
                {},
                "jmeno"
              ],
              "expected": "",
              "label": "[], 'jmeno'"
            },
            {
              "args": [
                {
                  "jmeno": [
                    "x"
                  ]
                },
                "jmeno"
              ],
              "expected": "",
              "label": "['jmeno' => ['x']], 'jmeno'"
            }
          ],
          "hint": "Hodnotu vezměte přes `?? ''`, a není-li to řetězec (`is_string`), vraťte `''`; jinak `trim()` (kapitola Knihovna formular.php)."
        },
        {
          "id": "escapuj",
          "description": "`escapuj(string $text): string` převede `< > & \" '` na entity",
          "type": "php.function",
          "file": "includes/formular.php",
          "name": "escapuj",
          "typed": true,
          "cases": [
            {
              "args": [
                "<b>\"x\" & 'y'</b>"
              ],
              "expected": "&lt;b&gt;&quot;x&quot; &amp; &#039;y&#039;&lt;/b&gt;"
            }
          ],
          "hint": "Funkce jen vrátí `htmlspecialchars($text)` (kapitola Ošetření výstupu)."
        },
        {
          "id": "require-index",
          "description": "`index.php` načítá `includes/formular.php`",
          "type": "php.page",
          "source_contains": [
            "includes/formular.php"
          ],
          "hint": "Pod načtení `functions.php` přidejte `require_once __DIR__ . '/includes/formular.php';` (úkol 1)."
        },
        {
          "id": "require-aboutme",
          "description": "`aboutme.php` načítá `includes/formular.php`",
          "type": "php.page",
          "file": "aboutme.php",
          "source_contains": [
            "includes/formular.php"
          ],
          "hint": "Pod načtení `functions.php` přidejte `require_once __DIR__ . '/includes/formular.php';` (úkol 1)."
        },
        {
          "id": "require-contact",
          "description": "`contact.php` načítá `includes/formular.php`",
          "type": "php.page",
          "file": "contact.php",
          "source_contains": [
            "includes/formular.php"
          ],
          "hint": "Pod načtení konfigurace přidejte `require_once __DIR__ . '/includes/formular.php';` (úkol 1)."
        }
      ]
    },
    {
      "id": "adresa",
      "name": "Bezpečné hodnoty z adresy (úkol 2)",
      "prefix": "B",
      "file": "includes/formular.php",
      "checks": [
        {
          "id": "nacti-volbu",
          "description": "`nactiVolbu(array $data, string $klic, array $povolene): ?string` vrací jen povolenou hodnotu",
          "type": "php.function",
          "name": "nactiVolbu",
          "typed": true,
          "cases": [
            {
              "args": [
                {
                  "rok": "2024"
                },
                "rok",
                [
                  "2023",
                  "2024"
                ]
              ],
              "expected": "2024"
            },
            {
              "args": [
                {
                  "rok": "2026"
                },
                "rok",
                [
                  "2023",
                  "2024"
                ]
              ],
              "expected": null
            },
            {
              "args": [
                {
                  "rok": [
                    "2024"
                  ]
                },
                "rok",
                [
                  "2023",
                  "2024"
                ]
              ],
              "expected": null,
              "label": "['rok' => ['2024']], 'rok', ['2023', '2024']"
            },
            {
              "args": [
                {},
                "rok",
                [
                  "2023",
                  "2024"
                ]
              ],
              "expected": null,
              "label": "[], 'rok', ['2023', '2024']"
            }
          ],
          "hint": "Hodnotu vezměte přes `?? null` a vraťte ji, jen když `in_array($hodnota, $povolene, true)`; jinak `null` (kapitola Funkce pro checkbox a výběr)."
        },
        {
          "id": "nacti-cislo",
          "description": "`nactiCislo(array $data, string $klic, int $min, int $max): ?int` vrací celé číslo v rozsahu, jinak `null`",
          "type": "php.function",
          "name": "nactiCislo",
          "typed": true,
          "cases": [
            {
              "args": [
                {
                  "days": "17"
                },
                "days",
                -365,
                365
              ],
              "expected": 17
            },
            {
              "args": [
                {
                  "days": "-3"
                },
                "days",
                -365,
                365
              ],
              "expected": -3
            },
            {
              "args": [
                {
                  "days": "abc"
                },
                "days",
                -365,
                365
              ],
              "expected": null
            },
            {
              "args": [
                {
                  "days": "400"
                },
                "days",
                -365,
                365
              ],
              "expected": null
            },
            {
              "args": [
                {
                  "days": ""
                },
                "days",
                -365,
                365
              ],
              "expected": null
            },
            {
              "args": [
                {
                  "days": [
                    "3"
                  ]
                },
                "days",
                -365,
                365
              ],
              "expected": null,
              "label": "['days' => ['3']], 'days', -365, 365"
            },
            {
              "args": [
                {},
                "days",
                -365,
                365
              ],
              "expected": null,
              "label": "[], 'days', -365, 365"
            }
          ],
          "hint": "`filter_var(…, FILTER_VALIDATE_INT, ['options' => ['min_range' => $min, 'max_range' => $max]])` vrátí `false`, když hodnota neprojde — z `false` udělejte `null` (kapitola E-mail a čísla)."
        },
        {
          "id": "days",
          "description": "`index.php?days=abc` ukazuje `Do odevzdání zbývá 12 dní.`",
          "type": "php.page",
          "file": "index.php",
          "query": {
            "days": "abc"
          },
          "expected": "Do odevzdání zbývá 12 dní.",
          "hint": "`$daysLeft = nactiCislo($_GET, 'days', -365, 365) ?? 12;` — neplatné číslo nahradí výchozí hodnota (úkol 2)."
        },
        {
          "id": "status",
          "description": "`aboutme.php?status=hacked` ukazuje stav `čeká na schválení`",
          "type": "php.page",
          "file": "aboutme.php",
          "query": {
            "status": "hacked"
          },
          "expected": "čeká na schválení",
          "hint": "`$status = nactiVolbu($_GET, 'status', ['approved', 'pending', 'rejected']) ?? 'pending';` (úkol 2)."
        }
      ]
    },
